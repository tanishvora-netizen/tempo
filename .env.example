# Tempo environment variables. Copy to .env for local overrides. The full demo works with none of these set.

# Which AI provider to use: "ollama" (local model, default when reachable), "cached" (replay committed
# outputs; always used on the hosted demo), or "anthropic" (only if TEMPO_ALLOW_EXTERNAL_LLM=1 and a key is set).
TEMPO_PROVIDER=

# Local model tag served by Ollama. Overrides .tempo_local_model (written by the setup script).
TEMPO_LOCAL_MODEL=
# Ollama endpoint (local only).
OLLAMA_HOST=http://127.0.0.1:11434

# Hosted model adapter: disabled unless BOTH of these are set. Never set on the hosted demo.
TEMPO_ALLOW_EXTERNAL_LLM=0
ANTHROPIC_API_KEY=
TEMPO_ANTHROPIC_EXTRACT_MODEL=claude-haiku-5-5
TEMPO_ANTHROPIC_DRAFT_MODEL=claude-sonnet-5-5

# Where the audit log is written (append-only JSONL).
TEMPO_AUDIT_PATH=data/audit/audit.jsonl
