{
  "enabledPlugins": {
    "ecc@ecc": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "env": {
    "ECC_HOOK_PROFILE": "minimal",
    "ECC_GATEGUARD": "off",
    "ECC_CONTEXT_MONITOR_COST_WARNINGS": "off"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/keep_going.py"
          }
        ]
      }
    ]
  }
}
